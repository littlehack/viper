{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "<YOUR_OPENCODE_CONFIG>/plugins/viper",
      "options": {
        "agents": "*",
        "permissions": true,
        "setDefault": false,
        "framePrompts": true,
        "autoEngage": true,
        "autoScope": true,
        "audit": true,
        "scopeFile": "<YOUR_OPENCODE_CONFIG>/lab-scope.json",
        "auditFile": "<YOUR_OPENCODE_CONFIG>/lab-audit.jsonl"
      }
    }
  ]
}
